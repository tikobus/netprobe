[Unit]
Description=NetProbe Network Device Monitor
Documentation=https://github.com/example/netprobe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netprobe
Group=netprobe
ExecStart=/usr/local/bin/netprobe -config /etc/netprobe/config.yaml
Restart=on-failure
RestartSec=5

# ICMP 探测所需能力（非 root 运行 raw socket）
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# 资源与安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/netprobe /var/log/netprobe
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# 日志走 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netprobe

[Install]
WantedBy=multi-user.target
